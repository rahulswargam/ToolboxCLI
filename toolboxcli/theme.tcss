/* ToolboxCLI theme — Tokyo Night inspired.
   Palette lives in core/theme.py; keep these in sync. */

Screen {
    background: #1A1B26;
    color: #C0CAF5;
}

/* ── Header ─────────────────────────────────────────────────────────── */
/* Height is generous enough for the 4-line pyfiglet banner plus padding;
   on a narrow terminal AppHeader falls back to a one-line title, which
   just leaves some empty space here rather than overflowing. */
#app-header {
    height: 6;
    background: #24283B;
    color: #7AA2F7;
    text-style: bold;
    content-align: center middle;
    border-top: heavy #BB9AF7;
    border-bottom: heavy #7AA2F7;
}

#hint-bar {
    height: 1;
    background: #1A1B26;
    color: #565F89;
    content-align: center middle;
}

#status-bar {
    height: 1;
    background: #24283B;
    color: #565F89;
    padding: 0 2;
}

/* ── Category sections ──────────────────────────────────────────────── */
.category-header {
    height: 2;
    color: #FF9E64;
    text-style: bold;
    padding: 0 0 0 1;
    margin: 1 0 0 0;
    border-bottom: solid #BB9AF7 30%;
}

/* Rows scroll horizontally so a category with many (or long-named) tools
   never truncates its last card on a narrow terminal — the active card is
   scrolled into view by the navigator. */
.card-row {
    height: 5;
    layout: horizontal;
    padding: 0 1;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
    scrollbar-color: #414868;
    scrollbar-background: #1A1B26;
}

/* ── Tool cards ─────────────────────────────────────────────────────── */
ToolCard {
    width: auto;
    min-width: 22;
    height: 3;
    border: round #414868;
    color: #C0CAF5;
    content-align: center middle;
    margin: 0 1 0 0;
    padding: 0 1;
}

ToolCard.-active {
    border: double #7AA2F7;
    color: #7AA2F7;
    text-style: bold;
    background: #24283B;
}

/* ── Task screen ────────────────────────────────────────────────────── */
#task-title {
    height: 1;
    color: #7AA2F7;
    text-style: bold;
    padding: 0 1;
}

#task-desc {
    height: auto;
    color: #565F89;
    padding: 0 1 1 1;
}

#prompt-label {
    height: auto;
    color: #BB9AF7;
    padding: 1 1 0 1;
}

Input {
    margin: 0 1;
    background: #24283B;
    border: round #414868;
}

Input:focus {
    border: round #BB9AF7;
}

/* Choice prompts: an arrow-navigable list instead of typing a number. */
#prompt-choices {
    height: auto;
    max-height: 10;
    margin: 0 1;
    background: #24283B;
    border: round #BB9AF7;
}

#prompt-choices > .option-list--option-highlighted {
    background: #7AA2F7;
    color: #1A1B26;
    text-style: bold;
}

/* Creative loading state: a pulsing indicator plus the current step,
   replacing a static checklist so a run always feels alive. */
#loading-area {
    height: auto;
    align: center middle;
    padding: 1 0;
}

#loading-spinner {
    height: 3;
    color: #BB9AF7;
}

#loading-step {
    height: 1;
    content-align: center middle;
}

ProgressBar {
    margin: 1 1;
}

Bar > .bar--indeterminate { color: #BB9AF7; }
PercentageStatus { color: #7AA2F7; text-style: bold; }

Bar > .bar--bar { color: #7AA2F7; }
Bar > .bar--complete { color: #9ECE6A; }

#log-panel {
    height: 1fr;
    min-height: 6;
    border: round #414868;
    background: #16161E;
    margin: 1;
    padding: 0 1;
}

#result-banner {
    height: auto;
    padding: 1;
    margin: 0 1;
    text-style: bold;
}

#result-banner.-ok {
    color: #9ECE6A;
    border: round #9ECE6A;
}

#result-banner.-fail {
    color: #F7768E;
    border: round #F7768E;
}

#footer-credit {
    height: 1;
    color: #565F89;
    content-align: center middle;
    background: #24283B;
}
