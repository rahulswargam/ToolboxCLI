/* ToolboxCLI theme — JobSprint house style.
   Palette lives in core/theme.py; keep these in sync.

   Design rules followed throughout:
   - Plain dark terminal surfaces, never a filled colour panel.
   - The banner is the one place with a heavy border — double-line violet,
     matching JobSprint's title box. Every other panel is rounded.
   - Active/selected state is a cyan border + cyan "»" indicator, never a
     solid filled background. */

Screen {
    background: #121212;
    color: #e4e4e4;
}

/* ── Header ─────────────────────────────────────────────────────────── */
/* The one double-line border in the whole UI — the JobSprint title box. */
#app-header {
    height: auto;
    min-height: 9;
    background: #121212;
    color: #d787ff;
    text-style: bold;
    content-align: center middle;
    border: double #d787ff;
    padding: 1 2;
    margin: 1 1 0 1;
}

#hint-bar {
    height: 1;
    background: #121212;
    color: #8a8a8a;
    content-align: center middle;
    margin: 1 0;
}

/* ── Category sections ──────────────────────────────────────────────── */
.category-header {
    height: 2;
    color: #00d7ff;
    text-style: bold;
    padding: 0 0 0 2;
    margin: 1 0 0 0;
    border-bottom: solid #5f5f5f;
}

/* Rows scroll horizontally so a category with many (or long-named) tools
   never truncates its last card on a narrow terminal — the active card is
   scrolled into view by the navigator. */
.card-row {
    height: 5;
    layout: horizontal;
    padding: 0 2;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 1;
    scrollbar-color: #5f5f5f;
    scrollbar-background: #121212;
}

/* ── Tool cards ─────────────────────────────────────────────────────── */
ToolCard {
    width: auto;
    min-width: 24;
    height: 3;
    border: round #5f5f5f;
    color: #e4e4e4;
    content-align: center middle;
    margin: 0 1 0 0;
    padding: 0 2;
}

ToolCard.-active {
    border: round #00d7ff;
    color: #00d7ff;
    text-style: bold;
    background: #121212;
}

/* ── Task screen ────────────────────────────────────────────────────── */
#task-title {
    height: 1;
    color: #d787ff;
    text-style: bold;
    padding: 0 2;
    margin: 1 0 0 0;
}

#task-desc {
    height: auto;
    color: #8a8a8a;
    padding: 0 2 1 2;
}

#prompt-label {
    height: auto;
    color: #00d7ff;
    padding: 1 2 0 2;
}

Input {
    margin: 0 2;
    background: #1c1c1c;
    color: #e4e4e4;
    border: round #5f5f5f;
    padding: 0 1;
}

Input:focus {
    border: round #00d7ff;
}

/* Choice prompts: an arrow-navigable list instead of typing a number. */
#prompt-choices {
    height: auto;
    max-height: 10;
    margin: 0 2;
    background: #1c1c1c;
    border: round #00d7ff;
    padding: 0 1;
}

#prompt-choices > .option-list--option-highlighted {
    background: #1c1c1c;
    color: #00d7ff;
    text-style: bold;
}

/* Creative loading state: a pulsing indicator plus the current step,
   replacing a static checklist so a run always feels alive. */
#loading-area {
    height: auto;
    align: center middle;
    padding: 2 0;
}

#loading-spinner {
    height: 3;
    color: #00d7ff;
}

#loading-step {
    height: 1;
    content-align: center middle;
}

ProgressBar {
    margin: 1 2;
}

Bar > .bar--indeterminate { color: #00d7ff; }
PercentageStatus { color: #d787ff; text-style: bold; }

Bar > .bar--bar { color: #d787ff; }
Bar > .bar--complete { color: #5fd75f; }

#log-panel {
    height: 1fr;
    min-height: 6;
    border: round #5f5f5f;
    background: #0a0a0a;
    color: #e4e4e4;
    margin: 1 2;
    padding: 1 2;
}

#result-banner {
    height: auto;
    padding: 1 2;
    margin: 1 2;
    text-style: bold;
    border: round #5f5f5f;
}

#result-banner.-ok {
    color: #5fd75f;
    border: round #5fd75f;
}

#result-banner.-fail {
    color: #ff5f5f;
    border: round #ff5f5f;
}

#footer-credit {
    height: 1;
    color: #8a8a8a;
    content-align: center middle;
    background: #121212;
    margin: 1 1 1 1;
}
